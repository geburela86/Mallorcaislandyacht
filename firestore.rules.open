rules_version = '2';

// TEMPORAL — solo para verificar escritura en discountCodes y el resto del panel.
// Despliega con: npm run firebase:deploy-rules:open
// Vuelve a producción: npm run firebase:deploy-rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
