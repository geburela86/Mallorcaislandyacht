{
  "name": "mallorca-yacht",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "media:index": "node scripts/build-site-media-index.mjs",
    "routes:photos": "node scripts/download-route-photos.mjs",
    "media:webp": "node scripts/convert-public-to-webp.mjs && npm run media:index",
    "seo:generate": "node scripts/generate-sitemap.mjs",
    "build": "vite build && node scripts/build-site-media-index.mjs --dist && node scripts/generate-sitemap.mjs --dist && node scripts/prerender-seo-routes.mjs --dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "qr:web": "node scripts/generate-qr.mjs",
    "qr:reviews": "node scripts/generate-review-qr.mjs",
    "firebase:set-owner-claim": "node scripts/set-owner-custom-claim.mjs",
    "firebase:deploy-rules": "firebase deploy --only firestore:rules --project mallorca-yacht",
    "firebase:deploy-rules:open": "firebase deploy --only firestore:rules --project mallorca-yacht --config firebase.open.json"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.5.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.6.0",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "raw-body": "^3.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "resend": "^6.12.3",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.10"
  }
}
