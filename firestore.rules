rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isStaff() {
      return isSignedIn()
        && (request.auth.token.role == 'owner' || request.auth.token.role == 'bookings');
    }

    function isAnalyticsReader() {
      return isSignedIn()
        && (
          request.auth.token.role == 'owner'
          || request.auth.token.role == 'bookings'
          || request.auth.token.admin == true
        );
    }

    function discountCodeRedeemOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'active',
          'usedAt',
          'usedByBookingId',
          'useCount',
          'lastUsedAt',
          'lastUsedByBookingId',
        ]);
    }

    match /sitePublic/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /siteAdmin/{docId} {
      allow read, write: if isStaff();
    }

    match /blockedSlots/{slotId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create, update: if isSignedIn();
      allow delete: if isOwner();
    }

    // Códigos de descuento: get público (validar en reserva); CRUD admin = owner; update al reservar.
    match /discountCodes/{codeId} {
      allow get: if true;
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (isSignedIn() && discountCodeRedeemOnly());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isStaff();
    }

    match /meta/{docId} {
      allow get: if true;
      allow write: if isOwner();
    }

    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAnalyticsReader();
    }

    match /backups/{backupId} {
      allow read, write: if isOwner();
    }

    match /debug/{docId} {
      allow read, write: if isOwner();
    }
  }
}
