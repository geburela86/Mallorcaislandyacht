# Opcional: Firebase (reseñas, sincronización del sitio entre dispositivos, backups)
# Crea un proyecto en Firebase Console, añade una app Web y copia la config.
# Reglas Firestore (discountCodes, sitePublic, …): npm run firebase:deploy-rules
# Prueba temporal con reglas abiertas: npm run firebase:deploy-rules:open
# Claim owner para escritura admin: npm run firebase:set-owner-claim → logout/login Firebase
# La primera consulta a `bookings` puede pedir índice en Firestore Console si hace falta.
VITE_FIREBASE_API_KEY=
# Si en red ves 403 a identitytoolkit.googleapis.com: en Google Cloud → Credenciales → esa API key →
# restricciones de aplicación deben permitir el referrer de tu web (o «Ninguno» al probar en local).
# Debe coincidir con la app Web en Firebase Console (mismo proyecto que la API key).
# Producción Netlify (netlify.toml): mallorca-yacht.firebaseapp.com + mallorca-yacht
# Si ves auth/unauthorized-domain: revisa consola `firebaseConfig` y `window.location.hostname` vs Authorized domains.
VITE_FIREBASE_AUTH_DOMAIN=mallorca-yacht.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mallorca-yacht
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: token del formulario de reseñas si NO usas Firestore para meta/reviewGate.
# Debe coincidir con el token del QR / Admin → Settings.
VITE_REVIEW_GATE_TOKEN=

# Stripe Checkout (Vercel serverless: /api/create-checkout-session, /api/stripe-webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Origen público del sitio para success/cancel (ej. https://mallorcaislandyacht.com). En Vercel suele bastar VERCEL_URL si no defines SITE_URL.
SITE_URL=

# Resend (email transaccional de confirmación de reserva).
# Crea la API key en https://resend.com/api-keys (empieza por `re_`).
RESEND_API_KEY=
# Opcional: teléfono de contacto que aparece en el email de confirmación al cliente (si no, se usa el teléfono del huésped o info@).
CONTACT_PHONE=
# Opcional: destino del aviso interno de reserva pagada (por defecto info@mallorcaislandyacht.com).
ADMIN_NOTIFY_EMAIL=
# Remitente verificado en Resend. Recomendado en formato "Nombre <correo@dominio>",
# ej. Mallorca Island Yacht <bookings@mallorcaislandyacht.com>.
FROM_EMAIL=
# Firebase Admin (APIs /api/*): una de estas opciones (Vercel Dashboard + .env.local para `vercel dev`).
# A) JSON de la cuenta de servicio en una sola línea (Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT_JSON=
# B) Mismo JSON en Base64: node -e "console.log(Buffer.from(process.stdin.read()).toString('base64'))" < serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# C) Claves partidas (recomendado en Vercel si el JSON da problemas con comillas). En private_key usar \n como dos caracteres para saltos de línea.
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# (Alias sin ADMIN: FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY; project_id puede reutilizarse de VITE_FIREBASE_PROJECT_ID.)
# D) Local: ruta absoluta al JSON descargado (no subir el archivo al repo). `vercel dev` carga .env.local.
# GOOGLE_APPLICATION_CREDENTIALS=
# Vercel Cron: secreto opcional; Vercel envía Authorization: Bearer <CRON_SECRET> a /api/cleanup-expired-bookings
CRON_SECRET=
# Opcional: Vite proxy de /api hacia `vercel dev` → VITE_DEV_API_PROXY=http://127.0.0.1:3000
# VITE_DEV_API_PROXY=
# Opcional: si el SPA se sirve en otro host que el API, origen del API (sin barra final)
# VITE_CHECKOUT_API_BASE=https://tu-api.com
